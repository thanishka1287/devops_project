# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/
.cache/

# SQLite databases (data directory structure is kept via .gitkeep)
data/*.db
data/*.sqlite
data/*.sqlite3
!data/.gitkeep

# IDEs & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
